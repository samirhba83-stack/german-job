  MEDIUM
  LARGE
  ENTERPRISE
}

enum VisaSponsorship {
  NOT_OFFERED
  CASE_BY_CASE
  OFFERED
}

enum AusbildungSupport {
  NOT_OFFERED
  LIMITED
  OFFERED
}

model Company {
  id       String          @id @default(uuid())
  ownerId  String          @unique
  owner    User            @relation(fields: [ownerId], references: [id])
  name     String
  status   CompanyStatus   @default(ACTIVE)
  industry CompanyIndustry
  size     CompanySize

  city         String
  country      String
  postalCode   String?
  street       String?
