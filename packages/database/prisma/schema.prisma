// ---------- Company Domain ----------

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum CompanyIndustry {
  IT_SOFTWARE
  ENGINEERING
  MANUFACTURING
  FINANCE
  HEALTHCARE
  RETAIL
  LOGISTICS
