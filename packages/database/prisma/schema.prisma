// Prisma schema — structural stubs only, no business logic.
// Fields are limited to what's needed for a valid schema per bounded context.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development (Windows/macOS/Linux hosts running `prisma generate`
  // directly); "linux-musl-openssl-3.0.x" is required for the Alpine-based Docker image, whose
  // OpenSSL 3.0 runtime has no libssl.so.1.1 — Prisma's engine auto-detection defaults to the
  // 1.1.x target when it can't positively identify the OpenSSL version, which fails at runtime
  // inside the container. Pinning both targets removes the guesswork entirely.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users & Auth ----------

enum UserRole {
  ADMIN
  EMPLOYER
  CANDIDATE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(CANDIDATE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // M31 Phase 20/27 — real, immediate account suspension (Closed Beta admin operations /
  // Emergency Stop "disable one user"). Checked on every authenticated request
  // (`JwtStrategy.validate()`), not just at login — a suspended user's already-issued access
  // token stops working immediately, it does not merely block future logins. Same
  // boolean-flag-plus-reason shape this codebase already established for
  // `ConnectedMailbox.userDisabled`/`systemSuspended`, reused for consistency rather than
  // inventing a new status-enum shape for the same real concept.
  accountSuspended       Boolean   @default(false)
  accountSuspendedReason String?
  accountSuspendedAt     DateTime?
  accountSuspendedBy     String?

  company                Company?
  subscriptions          Subscription[]
  refreshToken           RefreshToken?
  profile                UserProfile?
  candidateDocuments     CandidateDocument[]
  connectedMailboxes     ConnectedMailbox[]
  oauthTransactions      OAuthTransaction[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  followUpControls       ApplicationFollowUpControl[]
  recruitmentTasks       RecruitmentActionTask[]
  usedBetaInvitation     BetaInvitation?

  @@map("users")
}

// M31 Phase 20 — Closed Beta Access Control. A dedicated, real, first-class concept — never a
// repurposed field on User — matching this codebase's own established "introduce a dedicated
// model for a real, distinct concept" discipline (e.g. M30's `ApplicationFollowUpControl`, never
// piggy-backed on an existing status field).
enum BetaInvitationStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

model BetaInvitation {
  id                String               @id @default(uuid())
  // Email-bound, not a generic shareable code — the real Closed Beta model the brief itself
  // suggests ("Approved email allowlist" + "Admin-issued invitation codes" combined): a leaked
  // code alone is not enough to register, since the registering email must match.
  email             String
  code              String               @unique
  status            BetaInvitationStatus @default(PENDING)
  invitedByAdminId  String
  usedByUserId      String?              @unique
  usedByUser        User?                @relation(fields: [usedByUserId], references: [id])
  usedAt            DateTime?
  revokedAt         DateTime?
  revokedByAdminId  String?
  revokedReason     String?
  expiresAt         DateTime
  createdAt         DateTime             @default(now())

  @@index([email])
  @@index([status])
  @@map("beta_invitations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("refresh_tokens")
}

