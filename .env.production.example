# Milestone 31.1 Phase 5 — Production environment secret template.
#
# NOT loaded by this application directly (see .env.staging.example's own header for why). Every
# value below is intentionally a bare placeholder, not even a `<GENERATE:...>` hint — per this
# milestone's own explicit instruction, Production values are not prepared speculatively; they are
# provisioned only once Product Owner approval for actual Production activation exists (the last
# item on this milestone's own AUTONOMY stop-list). This file's real job today is structural: it
# proves every Production-specific value has a real, named home to go into once that approval
# happens, so provisioning Production is mechanical, not improvised under pressure.
#
# Every key not listed here keeps its `.env.example` default/shape.

# --- Identity ---
APP_ENVIRONMENT=production
NODE_ENV=production
RUN_TICKS=true

# --- Database — a real, separate managed Postgres instance, distinct from Staging's ---
DATABASE_URL=

# --- Object storage — a real, separate bucket, distinct from Staging's ---
EMAIL_ATTACHMENT_STORAGE_PROVIDER=s3
EMAIL_ATTACHMENT_STORAGE_ENDPOINT=
EMAIL_ATTACHMENT_STORAGE_BUCKET=
EMAIL_ATTACHMENT_STORAGE_ACCESS_KEY=
EMAIL_ATTACHMENT_STORAGE_SECRET_KEY=

# --- Auth — unique to Production, never equal to Staging's or dev's ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Token encryption — unique to Production; see doc 31's rotation runbook before ever
# changing this once real tokens have been encrypted with it ---
MAILBOX_TOKEN_ENCRYPTION_KEY=

# --- Domain / URLs ---
CORS_ORIGIN=https://<approved-domain>
FRONTEND_URL=https://<approved-domain>

# --- Google OAuth — a SEPARATE Google Cloud project from Staging (doc 07); real Google
# "unverified app" -> verified app review is a separate, explicit, not-yet-taken step ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.<approved-domain>/mailbox-connections/callback/google
GOOGLE_INBOX_PUBSUB_TOPIC=
GOOGLE_INBOX_PUSH_AUTH_AUDIENCE=

# --- Microsoft Entra — a SEPARATE app registration from Staging (doc 08) ---
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://api.<approved-domain>/mailbox-connections/callback/microsoft
MICROSOFT_INBOX_WEBHOOK_URL=https://webhooks.<approved-domain>/inbox-webhooks/microsoft
MICROSOFT_INBOX_WEBHOOK_CLIENT_STATE=

# --- Paddle — real production credentials, a real legal/business decision, not made this pass ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# BILLING_PRODUCTION_PAYMENTS_ENABLED stays false regardless of the above until a separate,
# explicit decision to accept real payments is made (docs/billing/).
BILLING_PRODUCTION_PAYMENTS_ENABLED=false

# --- Email provider — real production credentials ---
EMAIL_PRIMARY_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Production Safety Flags — every one starts at its safe default. Advancing past Stage 0 of
# doc 21's Staged Activation Plan is a real, separate, explicit decision for each flag ---
PUBLIC_REGISTRATION_ENABLED=false
CLOSED_BETA_ENABLED=false
REAL_COMPANY_OUTREACH_ENABLED=false
PRODUCTION_WEBHOOK_PROCESSING_ENABLED=false

# --- Release identity — set by CI/CD, never by hand ---
# GIT_COMMIT=
# BUILD_TIMESTAMP=
# DEPLOYMENT_ACTOR=
