# Milestone 31.1 Phase 5 — Staging environment secret template.
#
# NOT a file this application loads directly (main.ts's envFilePath is `.env`/`../../.env` only —
# unchanged, since real Staging/Production secrets belong in the chosen secret manager, injected
# as real process environment variables at container start, never as a committed file — see
# docs/production-certification/05-secret-management.md and 02-environment-architecture.md).
#
# This file exists as the real, concrete reference for what to populate in that secret manager for
# Staging specifically: every value below is a REAL Staging value (not shared with dev, not shared
# with Production) once Phase 3/4's hosting decision is made and Staging is actually provisioned.
# Every key not listed here keeps its `.env.example` default/shape — only the keys that MUST be
# genuinely different per environment are repeated below.
#
# Placeholder convention: `<GENERATE:description>` means "generate a real, unique value for
# Staging specifically, never copy this from dev or from Production."

# --- Identity ---
APP_ENVIRONMENT=staging
NODE_ENV=production
RUN_TICKS=true

# --- Database — a real, separate managed Postgres instance, never the dev/Production one ---
DATABASE_URL=<GENERATE:real Staging Postgres connection string, from the chosen hosting provider>

# --- Object storage — a real, separate bucket, never dev MinIO or the Production bucket ---
EMAIL_ATTACHMENT_STORAGE_PROVIDER=s3
EMAIL_ATTACHMENT_STORAGE_ENDPOINT=<GENERATE:real Staging bucket endpoint>
EMAIL_ATTACHMENT_STORAGE_BUCKET=<GENERATE:real Staging bucket name, distinct from Production's>
EMAIL_ATTACHMENT_STORAGE_ACCESS_KEY=<GENERATE:real Staging storage credential>
EMAIL_ATTACHMENT_STORAGE_SECRET_KEY=<GENERATE:real Staging storage credential>

# --- Auth — unique per environment, never shared with dev or Production ---
JWT_ACCESS_SECRET=<GENERATE:32+ random bytes, unique to Staging>
JWT_REFRESH_SECRET=<GENERATE:32+ random bytes, unique to Staging, distinct from JWT_ACCESS_SECRET>

# --- Token encryption — unique per environment; rotating this makes every already-encrypted
# Staging token unreadable, so generate it once, carefully, and follow the rotation runbook
# (doc 31) for any future change ---
MAILBOX_TOKEN_ENCRYPTION_KEY=<GENERATE:base64 32-byte AES-256-GCM key, unique to Staging>

# --- Domain / URLs — real Staging subdomains once Phase 8's domain decision is made ---
CORS_ORIGIN=https://staging.<approved-domain>
FRONTEND_URL=https://staging.<approved-domain>

# --- Google OAuth — a SEPARATE Google Cloud project's credentials from Production (doc 07) ---
GOOGLE_OAUTH_CLIENT_ID=<GENERATE:real Staging Google Cloud OAuth client id>
GOOGLE_OAUTH_CLIENT_SECRET=<GENERATE:real Staging Google Cloud OAuth client secret>
GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.<approved-domain>/mailbox-connections/callback/google
GOOGLE_INBOX_PUBSUB_TOPIC=<GENERATE:real Staging Pub/Sub topic>
GOOGLE_INBOX_PUSH_AUTH_AUDIENCE=<GENERATE:real Staging push-auth audience secret>

# --- Microsoft Entra — a SEPARATE app registration from Production (doc 08) ---
MICROSOFT_OAUTH_CLIENT_ID=<GENERATE:real Staging Entra app client id>
MICROSOFT_OAUTH_CLIENT_SECRET=<GENERATE:real Staging Entra app client secret>
MICROSOFT_OAUTH_REDIRECT_URI=https://api-staging.<approved-domain>/mailbox-connections/callback/microsoft
MICROSOFT_INBOX_WEBHOOK_URL=https://webhooks-staging.<approved-domain>/inbox-webhooks/microsoft
MICROSOFT_INBOX_WEBHOOK_CLIENT_STATE=<GENERATE:real, random, per-environment secret>

# --- Paddle — sandbox credentials are fine for Staging (never Production credentials here) ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=<GENERATE:real Paddle sandbox key, Staging's own sandbox account/sub-account>
PADDLE_WEBHOOK_SECRET=<GENERATE:real Paddle sandbox webhook secret>

# --- Email provider — real sandbox/test credentials, Staging's own account or sub-account ---
EMAIL_PRIMARY_PROVIDER=resend
RESEND_API_KEY=<GENERATE:real Staging Resend test-mode key>
RESEND_WEBHOOK_SECRET=<GENERATE:real Staging Resend webhook secret>

# --- Production Safety Flags — Staging may enable these ONE AT A TIME during real certification
# (doc 21's Staged Activation Plan); never default them all on ---
PUBLIC_REGISTRATION_ENABLED=false
CLOSED_BETA_ENABLED=true
REAL_COMPANY_OUTREACH_ENABLED=false
PRODUCTION_WEBHOOK_PROCESSING_ENABLED=false

# --- Release identity — set by CI/CD, never by hand ---
# GIT_COMMIT=
# BUILD_TIMESTAMP=
# DEPLOYMENT_ACTOR=
