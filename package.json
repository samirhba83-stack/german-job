{
  "name": "german-job-engine",
  "version": "0.1.0",
  "private": true,
  "description": "German Job Engine — SaaS job search & matching platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @german-job-engine/database exec prisma generate",
    "db:migrate": "pnpm --filter @german-job-engine/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @german-job-engine/database exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
