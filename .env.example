# --- Database ---
POSTGRES_USER=job_engine
POSTGRES_PASSWORD=change_me
POSTGRES_DB=german_job_engine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://job_engine:change_me@localhost:5432/german_job_engine?schema=public
# M31 Phase 12 — recommended Staging/Production DATABASE_URL query params (Prisma passes these
# through to the underlying Postgres connection): connection_limit (cap the pool — a real number,
# not "however many the OS allows"), pool_timeout (seconds to wait for a free connection before
# erroring, rather than queuing forever), connect_timeout (seconds to wait for the initial TCP
# connection). Not applied to the local dev value above — a real value should be chosen once real
# Staging traffic/connection-count data exists (Phase 3's hosting decision affects how many DB
# connections are actually available). Example:
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public&connection_limit=10&pool_timeout=10&connect_timeout=10

# --- API (apps/api) ---
PORT=4000
NODE_ENV=development
# M31 Phase 2/7 — this process's real environment identity: development|staging|production.
# Validated at boot (EnvironmentValidationService) — an unset/misspelled value fails closed.
APP_ENVIRONMENT=development
# M31 Phase 3/4 — the real API/Worker process split. true (default) runs all 6 scheduled tick
# drivers in this process (today's single-process deployment); a split-process topology sets this
# to false on API replicas and leaves it true on exactly one dedicated Worker instance.
RUN_TICKS=true
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated list — Nest's CORS middleware accepts multiple allowed origins natively.
CORS_ORIGIN=http://localhost:3000
# M31 Phase 8 — the one, single, real redirect target for browser-facing flows (OAuth callbacks
# etc.) — distinct from CORS_ORIGIN (which may legitimately list several origins). Defaults to
# CORS_ORIGIN's first entry if unset.
FRONTEND_URL=http://localhost:3000
# M31 Phase 6 — build-time release identity (set by CI/CD via Docker --build-arg, never by hand
# in a real deployment); GET /version reports these. Left unset here — main.ts's release.config.ts
# defaults to "unknown" rather than a fabricated value.
# GIT_COMMIT=
# BUILD_TIMESTAMP=

# --- Closed Beta Access Control (M31 Phase 20/26/27) ---
# Both flags default to false (fail closed). PUBLIC_REGISTRATION_ENABLED=true is Public Launch —
# must stay false for the entire Controlled Closed Beta per this milestone's own explicit
# instruction. With PUBLIC_REGISTRATION_ENABLED=false, CLOSED_BETA_ENABLED is the real Emergency
# Stop position for registration as a whole: false closes registration outright (even a valid
# invitation is refused); true is the normal Closed Beta operating state (invitation-gated
# registration). Set true for local development so the invitation flow is exercisable.
PUBLIC_REGISTRATION_ENABLED=false
CLOSED_BETA_ENABLED=true
BETA_INVITATION_EXPIRY_DAYS=14

# --- Production Safety Flags (M31 Phase 26) ---
# Both default to false (fail closed). REAL_COMPANY_OUTREACH_ENABLED is the explicit, named gate
# for this milestone's single non-negotiable business rule: no application is ever sent to a real
# German company without separate Product Owner approval. Checked in addition to (not instead of)
# CONNECTED_MAILBOX_PRODUCTION_SENDING_ENABLED — both must independently be true before any real
# send can happen. Must stay false for the entire Controlled Closed Beta.
REAL_COMPANY_OUTREACH_ENABLED=false
# Gates whether Gmail/Microsoft Graph/email-provider webhooks act on an authenticated, audited
# notification (vs. acknowledge-but-skip) — see production-safety.config.ts's own doc comment for
# why Paddle billing webhooks are deliberately not covered by this flag. Stays false until Phase
# 9/10/11's real-world webhook certification is actually executed against a real provider.
PRODUCTION_WEBHOOK_PROCESSING_ENABLED=false
# M31.1 Phase 17 — comma-separated exact addresses and/or "@domain.com" wildcards. A send to an
# address on this list is permitted even while REAL_COMPANY_OUTREACH_ENABLED=false (this is what
# makes a real Staging dry run against known-safe test recipients possible); empty by default —
# an empty allowlist approves nobody, it never falls back to "allow everyone."
# TEST_RECIPIENT_ALLOWLIST=

# --- Billing (M27, Paddle, sandbox-only by default) ---
# PADDLE_ENVIRONMENT must be "sandbox" (default) or "production". Real charges never happen
# unless BILLING_PRODUCTION_PAYMENTS_ENABLED=true AND PADDLE_ENVIRONMENT=production AND every
# credential below is set — see docs/billing/ for the production activation checklist.
PADDLE_ENVIRONMENT=sandbox
BILLING_PRODUCTION_PAYMENTS_ENABLED=false
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PROFESSIONAL=
PADDLE_PRICE_ID_PREMIUM=
PADDLE_PRICE_ID_ENTERPRISE=
PADDLE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
PADDLE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=canceled
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_CHECKOUT_EXPIRY_MINUTES=30
BILLING_REFUND_WINDOW_DAYS=7

# --- Email Infrastructure (M28) ---
# Real external sending requires EMAIL_PRODUCTION_SENDING_ENABLED=true AND at least one provider
# below fully configured (each adapter's own isAvailable() reports false otherwise — see
# docs/email-infrastructure/ for the production activation checklist). EMAIL_PRIMARY_PROVIDER
# selects which adapter the simple single-provider facade (EmailProviderGatewayService, used by
# Billing's transactional notifications) resolves to; the real multi-provider automatic-failover
# path (Provider Manager) always considers every configured provider regardless of this setting.
EMAIL_PRODUCTION_SENDING_ENABLED=false
EMAIL_PRIMARY_PROVIDER=null

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_DAILY_LIMIT=

AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_DAILY_LIMIT=

SENDGRID_API_KEY=
# Base64 EC public key from the SendGrid dashboard (Settings -> Mail Settings -> Event Webhook) —
# verifies inbound webhooks; not itself a secret.
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_DAILY_LIMIT=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_DAILY_LIMIT=

EMAIL_QUEUE_ENABLED=true
EMAIL_QUEUE_TICK_INTERVAL_MS=5000
EMAIL_QUEUE_CONCURRENCY=10
EMAIL_QUEUE_MAX_ATTEMPTS=5
EMAIL_QUEUE_BASE_BACKOFF_MS=30000
EMAIL_QUEUE_MAX_BACKOFF_MS=1800000

EMAIL_SEND_TIMEOUT_MS=10000
EMAIL_CIRCUIT_BREAKER_THRESHOLD=5
EMAIL_CIRCUIT_BREAKER_COOLDOWN_MS=300000
EMAIL_WEBHOOK_TOLERANCE_SECONDS=300

# --- Attachment Security & Sender Identity (M28.5) ---
# EMAIL_ATTACHMENTS_PRODUCTION_ENABLED and EMAIL_SENDER_IDENTITY_ENFORCEMENT_ENABLED are
# independent kill switches from EMAIL_PRODUCTION_SENDING_ENABLED (M28) — see the M28.5 report's
# Production Safety Gates section for the full fail-closed matrix. Both default false.
EMAIL_ATTACHMENTS_PRODUCTION_ENABLED=false
EMAIL_SENDER_IDENTITY_ENFORCEMENT_ENABLED=false

# Object storage for candidate documents (CV/motivation letter/supporting docs) — MinIO
# (self-hosted, S3-compatible) by default; the adapter is written against the standard S3 API,
# so pointing EMAIL_ATTACHMENT_STORAGE_ENDPOINT at real AWS S3 (and setting real credentials) is
# a config change, not a code change.
EMAIL_ATTACHMENT_STORAGE_PROVIDER=minio
EMAIL_ATTACHMENT_STORAGE_ENDPOINT=http://localhost:9000
EMAIL_ATTACHMENT_STORAGE_PORT=9000
EMAIL_ATTACHMENT_STORAGE_CONSOLE_PORT=9001
EMAIL_ATTACHMENT_STORAGE_REGION=us-east-1
EMAIL_ATTACHMENT_STORAGE_BUCKET=candidate-documents
EMAIL_ATTACHMENT_STORAGE_ACCESS_KEY=
EMAIL_ATTACHMENT_STORAGE_SECRET_KEY=

EMAIL_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
EMAIL_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=20971520
EMAIL_ATTACHMENT_MAX_COUNT=5

# The one approved initial sender identity (Phase 11 — "Safe Sender Strategy"): a verified
# platform domain, never an arbitrary user's own From address.
EMAIL_SENDER_PLATFORM_DISPLAY_NAME=German Job Engine
EMAIL_SENDER_PLATFORM_EMAIL_ADDRESS=
EMAIL_SENDER_PLATFORM_DOMAIN=

# --- Connected Mailbox (M28.6) ---
# Candidate application emails send from the candidate's own connected Gmail/Outlook mailbox, not
# a platform sender. Real production sending requires CONNECTED_MAILBOX_PRODUCTION_SENDING_ENABLED
# =true AND a configured MAILBOX_TOKEN_ENCRYPTION_KEY AND real Google/Microsoft OAuth app
# credentials — see docs/email-infrastructure/ for the production activation checklist. Without a
# configured encryption key, connecting a mailbox is impossible (the token vault fails closed).
CONNECTED_MAILBOX_PRODUCTION_SENDING_ENABLED=false

# Base64-encoded 32-byte (256-bit) AES-256-GCM key, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MAILBOX_TOKEN_ENCRYPTION_KEY=
MAILBOX_TOKEN_ENCRYPTION_KEY_VERSION=1

# Google Cloud OAuth 2.0 client (Gmail send scope only — see the M28.6 report's Google Cloud
# Configuration Checklist). GOOGLE_OAUTH_REDIRECT_URI must exactly match what is registered in the
# Google Cloud Console and must point at this API's own callback controller, never a frontend route.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/mailbox-connections/callback/google

# Microsoft Entra app registration (Mail.Send scope only — see the M28.6 report's Microsoft Entra
# Configuration Checklist). MICROSOFT_OAUTH_TENANT="common" accepts both personal and work/school
# accounts; narrow it to a specific tenant id for a single-tenant production app registration.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/mailbox-connections/callback/microsoft
MICROSOFT_OAUTH_TENANT=common

OAUTH_TRANSACTION_EXPIRY_MINUTES=10
CONNECTED_MAILBOX_CONSENT_VERSION=1.0

# Conservative, real-world-informed defaults (Phase 13) — a connected personal mailbox is never
# treated like bulk-email infrastructure. Review before scaling up.
CONNECTED_MAILBOX_DAILY_SEND_LIMIT=30
CONNECTED_MAILBOX_HOURLY_SEND_LIMIT=10
CONNECTED_MAILBOX_MIN_SEND_INTERVAL_MS=20000
CONNECTED_MAILBOX_WARMUP_DAYS=7
CONNECTED_MAILBOX_WARMUP_DAILY_LIMIT=5
CONNECTED_MAILBOX_FAILURE_RATE_THRESHOLD=0.3
CONNECTED_MAILBOX_FAILURE_RATE_MIN_SAMPLES=5

# A domain this application owns purely as a Message-ID uniqueness namespace (RFC 5322 does not
# require it to resolve via DNS) — used only by the Gmail adapter, which builds its own raw MIME.
CONNECTED_MAILBOX_MESSAGE_ID_DOMAIN=mail.germanjobengine.internal

# --- M31.1 Phase 5 — real vars found in code but missing from this file until now (found by
# diffing every process.env.X reference in apps/api/src/config/*.ts against this file) ---

# --- Execution Activation (M26) ---
EXECUTION_ACTIVATION_ENABLED=true
EXECUTION_ACTIVATION_TICK_INTERVAL_MS=30000
EXECUTION_ACTIVATION_LOCK_TTL_MS=60000
EXECUTION_ACTIVATION_MAX_RETRY_ATTEMPTS=3
# SAFE (default) | SANDBOX | PRODUCTION — PRODUCTION alone is not sufficient for a real send; see
# execution-activation.config.ts's own doc comment.
EMAIL_DELIVERY_MODE=SAFE

# --- Inbox Intelligence (M29) — every *_ENABLED flag defaults false, fail-closed ---
CONNECTED_INBOX_PROCESSING_ENABLED=false
INBOX_AI_CLASSIFICATION_ENABLED=false
INBOX_REPLY_DRAFTING_ENABLED=false
INBOX_AUTOMATIC_REPLY_ENABLED=false
INBOX_CONSENT_VERSION=1.0
INBOX_EXCERPT_RETENTION_DAYS=90
INBOX_MAX_MESSAGE_SIZE_BYTES=5242880
INBOX_POLLING_ENABLED=true
INBOX_POLLING_TICK_INTERVAL_MS=120000
INBOX_WATCH_RENEWAL_HORIZON_HOURS=24
INBOX_WATCH_RENEWAL_TICK_INTERVAL_MS=3600000
# A real Google Cloud Pub/Sub topic (projects/PROJECT/topics/TOPIC) — empty until Phase 6/7 of
# M31.1 (real Google Cloud test project) is executed.
GOOGLE_INBOX_PUBSUB_TOPIC=
GOOGLE_INBOX_PUSH_AUTH_AUDIENCE=
MICROSOFT_INBOX_WEBHOOK_URL=
MICROSOFT_INBOX_WEBHOOK_CLIENT_STATE=

# --- Recruitment Operations (M30) — every *_ENABLED flag defaults false, fail-closed ---
REPLY_DRIVEN_EXECUTION_ENABLED=false
FOLLOW_UP_SUPPRESSION_ENABLED=false
RECRUITMENT_TASK_AUTOMATION_ENABLED=false
AUTOMATIC_HIGH_IMPACT_TRANSITIONS_ENABLED=false
RECRUITMENT_RESUME_TICK_INTERVAL_MS=1800000
RECRUITMENT_DEADLINE_TICK_INTERVAL_MS=900000

# --- Release / Deployment identity (M31, real value injected by CI/CD only — never by hand) ---
# DEPLOYMENT_ACTOR=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
